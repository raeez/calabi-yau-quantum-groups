\@writefile{lot}{\contentsline {table}{\numberline {20.1}{\ignorespaces Grand atlas of CY$_3$ shadow invariants. Columns: CY$_3$ family, topological Euler characteristic~$\chi $, Hodge numbers $h^{1,1}$ and $h^{2,1}$, modular characteristic~$\kappa $, shadow depth class, and data source. For non-compact toric CY$_3$: $\kappa = \chi (S)/2$ where $S$ is the compact base (Proposition~\ref {prop:toric-kappa-table}). For compact CICYs: $\kappa = \chi _{\mathrm  {top}}/24$. For K3-fibered geometries: $\kappa $ is the automorphic weight. Families above the first rule are non-compact toric; between the rules are K3-fibered; below are compact complete intersections and special families. BV = Borcea--Voisin.}}{124}{table.20.1}\protected@file@percent }
\newlabel{tab:cy3-grand-atlas}{{20.1}{124}{Grand atlas of CY$_3$ shadow invariants. Columns: CY$_3$ family, topological Euler characteristic~$\chi $, Hodge numbers $h^{1,1}$ and $h^{2,1}$, modular characteristic~$\kappa $, shadow depth class, and data source. For non-compact toric CY$_3$: $\kappa = \chi (S)/2$ where $S$ is the compact base (Proposition~\ref {prop:toric-kappa-table}). For compact CICYs: $\kappa = \chi _{\mathrm {top}}/24$. For K3-fibered geometries: $\kappa $ is the automorphic weight. Families above the first rule are non-compact toric; between the rules are K3-fibered; below are compact complete intersections and special families. BV = Borcea--Voisin}{table.20.1}{}}
