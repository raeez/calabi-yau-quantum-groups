\@writefile{lot}{\contentsline {table}{\numberline {17.1}{\ignorespaces Grand atlas of CY$_3$ shadow invariants. Columns: CY$_3$ family, topological Euler characteristic~$\chi $, Hodge numbers $h^{1,1}$ and $h^{2,1}$, modular characteristic~$\kappa _{\mathrm  {ch}}$, shadow depth class, and data source. For non-compact toric CY$_3$: $\kappa _{\mathrm  {ch}} = \chi (S)/2$ where $S$ is the compact base (Proposition~\ref {prop:toric-kappa-table}). For compact CICYs: $\kappa _{\mathrm  {ch}} = \chi _{\mathrm  {top}}/24$. For K3-fibered geometries: $\kappa _{\mathrm  {ch}}$ is the automorphic weight. Families above the first rule are non-compact toric; between the rules are K3-fibered; below are compact complete intersections and special families. BV = Borcea--Voisin.}}{194}{table.17.1}\protected@file@percent }
\newlabel{tab:cy3-grand-atlas}{{17.1}{194}{Grand atlas of CY$_3$ shadow invariants. Columns: CY$_3$ family, topological Euler characteristic~$\chi $, Hodge numbers $h^{1,1}$ and $h^{2,1}$, modular characteristic~$\kappa _{\mathrm {ch}}$, shadow depth class, and data source. For non-compact toric CY$_3$: $\kappa _{\mathrm {ch}} = \chi (S)/2$ where $S$ is the compact base (Proposition~\ref {prop:toric-kappa-table}). For compact CICYs: $\kappa _{\mathrm {ch}} = \chi _{\mathrm {top}}/24$. For K3-fibered geometries: $\kappa _{\mathrm {ch}}$ is the automorphic weight. Families above the first rule are non-compact toric; between the rules are K3-fibered; below are compact complete intersections and special families. BV = Borcea--Voisin}{table.17.1}{}}
